# FIJI Website — Environment Configuration Template
# ====================================================
# This file documents all environment variables used by the FIJI website.
# Copy this file to `.env.local` for local development overrides.
#
# IMPORTANT: Never commit .env files with real secrets. Only .env.example should be in git.
#
# Setup Instructions:
#   1. Copy this file: cp .env.example .env.local
#   2. Update values in .env.local with your configuration
#   3. .env.local is automatically ignored by git (.gitignore)

# ====================================================
# NEXT.JS CONFIGURATION
# ====================================================

# Next.js automatically sets NODE_ENV during builds:
# - "development" when running `npm run dev`
# - "production" when running `npm run build` or `npm start`
# (No need to set this manually)
# NODE_ENV=production

# ====================================================
# DEPLOYMENT CONFIGURATION
# ====================================================

# GitHub Pages deployment — repository name for basePath calculation
# Only used during production builds (NODE_ENV=production)
# Example: If deploying to https://user.github.io/fiji-website/
# then set STATIC_EXPORT_REPO=fiji-website
#
# Leave blank or omit for root domain deployment (https://example.com/)
STATIC_EXPORT_REPO=

# ====================================================
# FUTURE INTEGRATIONS (Examples for reference)
# ====================================================
# Uncomment and configure these when adding corresponding features:

# Google Analytics / Tracking
# NEXT_PUBLIC_GA_ID=G_XXXXXXXXXX

# Contact Form Backend / Email Service
# NEXT_PUBLIC_FORM_ENDPOINT=https://api.example.com/contact
# CONTACT_FORM_SECRET_KEY=your_secret_key_here

# Social Media Links (currently in src/constants/social.ts)
# NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/fiji.indonesia
# NEXT_PUBLIC_YOUTUBE_URL=https://youtube.com/c/fiji-indonesia
# NEXT_PUBLIC_TIKTOK_URL=https://tiktok.com/@fiji.indonesia

# CMS / Content Management (if future implementation needed)
# NEXT_PUBLIC_CMS_API_KEY=your_cms_api_key_here
# NEXT_PUBLIC_CMS_URL=https://api.cms.example.com

# ====================================================
# ENVIRONMENT-SPECIFIC FILES (IGNORED BY GIT)
# ====================================================
# These are automatically loaded by Next.js if they exist:
#
# .env.local — Local development overrides (always loaded)
# .env.development.local — Development-only overrides
# .env.test.local — Test environment overrides
# .env.production.local — Production-only overrides
#
# Priority order (highest to lowest):
# 1. .env.*.local (specific to environment)
# 2. .env.local (general local overrides)
# 3. .env.example (this file - checked into git)
# 4. Default Next.js behavior

